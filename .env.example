# Runtime
NODE_ENV=development
PORT=5001
HOST=127.0.0.1

# Database / storage
DATABASE_URL=

# Supabase Auth
# Required for the authentication demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Amadeus hotel API
# Optional. Fill only if showing hotel search.
AMADEUS_ENV=production
AMADEUS_API_KEY_TEST=
AMADEUS_API_SECRET_TEST=
AMADEUS_API_KEY_LIVE=
AMADEUS_API_SECRET_LIVE=

# Aviasales flight API
# Optional. Fill only if showing flight search.
AVIASALES_API_TOKEN=
AVIASALES_PARTNER_ID=

# Zapier / external automations
# Optional. Fill only if showing itinerary generation through webhook.
ZAPIER_WEBHOOK_URL=
IMAGE_SEARCH_API_KEY=

# Printful products
# Optional. Fill only if showing merchandising/product integration.
PRINTFUL_API_KEY=
PRINTFUL_CONFIRM_ORDERS=false

# Stripe payments
# Optional. Fill only if showing checkout/payment flow.
PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
